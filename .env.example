PROJECT_NAME="StenoVision Artery Analysis Engine"
# Primary Database: PostgreSQL (per official specification document)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stenovision_db
# Local persistence fallback if PostgreSQL server is not started on host:
SQLITE_FALLBACK_URL=sqlite:///./stenovision.db
SECRET_KEY=stenovision-secret-key-development-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FIRST_ADMIN_EMAIL=admin@stenovision.com
FIRST_ADMIN_PASSWORD=adminpassword123
# Medical Image Storage: Local Storage
STORAGE_ROOT=storage
MAX_UPLOAD_MB=50
